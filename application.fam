App(
    appid="f0phyphox",
    name="Phyphox Companion",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="phyphox_app_main",
    requires=["gui"],
    stack_size=6 * 1024,
    fap_category="Bluetooth",
    fap_description="DS18B20, DHT11 and GPIO voltage streamed to the phyphox app over BLE",
    fap_author="walktheearth",
    fap_version="2.0.0",
    sources=[
        "phyphox_app.cpp",
        "phyphox_ble.cpp",
        "lib/phyphox/phyphoxBleExperiment.cpp",
        "lib/phyphox/core/ChannelStore.cpp",
        "lib/phyphox/core/Crc32.cpp",
        "lib/phyphox/core/Errors.cpp",
        "lib/phyphox/core/ExperimentStore.cpp",
        "lib/phyphox/core/Serializer.cpp",
        "lib/phyphox/core/Server.cpp",
        "lib/phyphox/core/Sink.cpp",
        "lib/phyphox/core/Transfer.cpp",
    ],
)
